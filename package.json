{
  "name": "shuangxiugou",
  "description": "双休购 ·劳工友好品牌索引：查公司双休评级，避雷单休大小周996。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dujeongil-galaxy/shuangxiugou.git"
  },
  "homepage": "https://dujeongil-galaxy.github.io/shuangxiugou/",
  "bugs": {
    "url": "https://github.com/dujeongil-galaxy/shuangxiugou/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "verify": "node scripts/verify.mjs",
    "verify:quiet": "node scripts/verify.mjs --quiet",
    "sync-version": "node scripts/sync-version.mjs",
    "sync-version:check": "node scripts/sync-version.mjs --check",
    "precommit": "node scripts/verify.mjs --quiet",
    "lint": "npm run check-types",
    "check-types": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "seo:brands": "python scripts/seo/extract-brands.py && python scripts/seo/generate-brand-pages.py && python scripts/seo/link-brand-pages.py && python scripts/seo/generate-sitemap.py",
    "seo:sitemap": "python scripts/seo/generate-sitemap.py",
    "pinyin:build": "python scripts/gen-pinyin-index.py",
    "test:pinyin": "node scripts/test-pinyin-search.cjs",
    "test:pinyin:e2e": "node scripts/test-pinyin-e2e.cjs",
    "test:ticket": "node scripts/test-ticket-total.cjs",
    "test:ticket:dom": "node scripts/test-builtin-ticket-dom.cjs",
    "test:answer": "node scripts/test-answer-book.cjs",
    "test:apple-note": "node scripts/test-apple-note.cjs"
  },
  "dependencies": {
    "framer-motion": "^11.2.4",
    "next": "latest",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^3.7.2",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.17",
    "encoding": "^0.1.13",
    "jsdom": "^25.0.0",
    "postcss": "8.4.33",
    "prettier": "^2.8.8",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
